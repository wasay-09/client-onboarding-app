# Copy to /etc/onboarding-api.env on the VM, fill in real values, then lock it down:
#   sudo chown onboarding:onboarding /etc/onboarding-api.env
#   sudo chmod 600 /etc/onboarding-api.env
# NEVER commit the filled-in version. These are read by the systemd unit.

PORT=3001

# Your site's public origin (same origin as the SPA). Defense-in-depth for CORS;
# the API is only reachable via nginx at /onboarding/api anyway.
WEB_ORIGIN=https://your-domain.example

# Supabase Postgres — SESSION POOLER string (port 5432, IPv4), with ?sslmode=require.
DATABASE_URL=postgresql://postgres.<ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage (service-role key is server-only).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
SUPABASE_STORAGE_BUCKET=onboarding-pdfs

# Supabase Auth — the API verifies the user's JWT. Set the project's JWT secret
# (Settings -> API -> JWT Secret) for HS256 verification. Leave UNSET to verify via
# JWKS at ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (asymmetric-key projects).
# Server-only. AUTH_BYPASS must NOT be set in production (the API refuses to start
# with bypass on while DATABASE_URL is set).
SUPABASE_JWT_SECRET=<jwt-secret>

# stream (default) keeps PDFs same-origin; signed-url 302s to Supabase.
PDF_SERVE_MODE=stream
