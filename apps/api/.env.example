# The API runs with ZERO config locally (embedded pglite + local file storage).
# Everything below is optional.

PORT=3001
WEB_ORIGIN=http://localhost:5173

# Use a real Postgres (e.g. Supabase) instead of embedded pglite:
# DATABASE_URL=postgres://user:pass@host:5432/postgres

# Embedded pglite data dir (when DATABASE_URL is unset):
# PGLITE_DIR=.data/pgdata

# LocalPdfStorage root:
# STORAGE_DIR=.data/pdfs

# Production object storage (Supabase) — wired in src/storage.ts (SupabaseStorage):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=onboarding-pdfs
