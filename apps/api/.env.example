# The API runs with ZERO config locally (embedded pglite + local file storage).
# Everything below is optional for local dev; set it in production (env only — never commit).

PORT=3001
# CORS allow-origin. Same-origin prod (web + api under one domain) needs none; set
# it to your site origin as defense-in-depth, or '*' to allow any.
WEB_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------------
# Use a real Postgres (Supabase) instead of embedded pglite. Use the Supabase
# SESSION POOLER string (port 5432, IPv4) and append ?sslmode=require:
# DATABASE_URL=postgresql://postgres.<ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Embedded pglite data dir (when DATABASE_URL is unset):
# PGLITE_DIR=.data/pgdata

# --- PDF storage ----------------------------------------------------------------
# LocalPdfStorage root (used when the Supabase keys below are absent):
# STORAGE_DIR=.data/pdfs

# Supabase Storage (set all three -> SupabaseStorage). The service-role key is
# SERVER-ONLY and must never reach the browser or the repo.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=onboarding-pdfs

# How GET /cases/:id/pdf serves the file:
#   stream      (default) — proxy bytes through the API, same-origin
#   signed-url  — 302 to a short-lived Supabase signed URL (saves API egress)
# PDF_SERVE_MODE=stream
