# URL of the FBSI onboarding API. Defaults to http://localhost:3001 when unset.
VITE_API_URL=http://localhost:3001

# Production (served at example.com/onboarding behind nginx, same-origin):
#   VITE_API_URL=/onboarding         # relative -> calls example.com/onboarding/api/...
#   VITE_BASE=/onboarding/           # asset base path; MUST end with a slash
# Build for the subpath with:
#   VITE_BASE=/onboarding/ VITE_API_URL=/onboarding pnpm --filter web build
